def cmd_doctor(args) -> int:
    """Check environment and flag blockers."""
    profile = getattr(args, "profile", "paper")
    ok = True

    print(f"=== Raftel AE doctor (profile={profile}) ===")

    # SGX SDK
    sgxsdk = Path("/opt/intel/sgxsdk")
    if sgxsdk.exists():
        print(f"  [OK] SGX SDK found at {sgxsdk}")
    else:
        print(f"  [WARN] SGX SDK not found at {sgxsdk} — needed for cloud HW runs")
        if profile == "paper":
            ok = False

    # Python packages
    for pkg in ("paramiko", "scp", "matplotlib"):
        try:
            __import__(pkg)
            print(f"  [OK] Python package: {pkg}")
        except ImportError:
            print(f"  [FAIL] Missing Python package: {pkg}  (pip install {pkg})")
            ok = False

    # salticidae submodule
    sal = REPO / "salticidae" / "include" / "salticidae"
    if sal.exists():
        print(f"  [OK] salticidae submodule present")
    else:
        print(f"  [FAIL] salticidae submodule missing — run: git submodule update --init")
        ok = False

    # SSH key
    tshard = configured_ssh_key()
    if tshard.exists():
        mode = oct(tshard.stat().st_mode)[-3:]
        if mode in ("600", "400"):
            print(f"  [OK] SSH key {tshard} (permissions {mode})")
        else:
            print(f"  [WARN] SSH key has loose permissions {mode} — run: chmod 600 {tshard}")
    else:
        print(f"  [WARN] SSH key not found: {tshard}")
        if profile == "paper":
            ok = False

    # Aliyun config
    ali_cfg = ALIYUN_DIR / "config.json"
    if ali_cfg.exists():
        print(f"  [OK] aliyun/config.json present")
    elif (ALIYUN_DIR / "hosts.json").exists():
        print("  [OK] prepared cluster inventory present; cloud API credentials are not required")
    else:
        print("  [INFO] cloud API credentials absent (expected on reviewer coordinators)")
        # Path A uses existing hosts and does not require cloud API credentials.

    # ip_list for cloud runs
    if profile == "paper":
        ips = read_ip_list()
        if ips:
            print(f"  [OK] ip_list: {len(ips)} host(s) configured")
        else:
            print("  [FAIL] aliyun/priv_ip.txt is empty or missing — coordinator inventory is not prepared")
            ok = False

    # git state
    commit = git_commit()
    print(f"  [INFO] git commit: {commit}")

    if ok:
        print("\ndoctor: all checks passed")
        return 0
    else:
        print("\ndoctor: one or more checks FAILED — fix above before running experiments")
        return 1


def cmd_run(args) -> int:
    """Run one or all experiments and produce a run directory."""
    figs = ["fig3", "fig4", "fig6"] if args.fig == "all" else [args.fig]
    mode = resolve_mode(args)
    scale = "simulation" if mode == "sim" else "full"
    required = required_host_count(figs, mode)

    # A developer launcher forwards work to the prepared coordinator. A
    # reviewer already logged into that coordinator must execute locally and
    # reach replicas over their VPC addresses.
    local_runner = running_on_cloud_runner()
    if local_runner:
        os.environ["RAFTEL_USE_PRIVATE_SSH"] = "1"
    if not getattr(args, "on_runner", False) and not local_runner and cloud_runner():
        return run_via_cloud_runner(args)

    # A prepared runner bootstraps a disposable replica cluster without
    # reviewer interaction. Credentials and runner identity remain outside the
    # public artifact repository.
    auto_provisioned = False
    prepare_mode_environment(mode)
    if local_runner and not read_ip_list():
        print(f"No replica inventory found; provisioning {required} {mode} replica hosts...")
        clear_stale_replica_ledger()
        profile = "simulation" if scale == "simulation" else "paper"
        if cmd_cloud(SimpleNamespace(
            action="up", count=required, no_runner=True, profile=profile
        )) != 0:
            ledger = ALIYUN_DIR / "instances.txt"
            if ledger.is_file() and ledger.read_text().strip():
                print("Replica provisioning failed; releasing created resources...", file=sys.stderr)
                cmd_cloud(SimpleNamespace(action="down", count=None, no_runner=False))
            return 1
        auto_provisioned = True
        if cmd_cloud(SimpleNamespace(action="init", count=None, no_runner=True)) != 0:
            cmd_cloud(SimpleNamespace(action="down", count=None, no_runner=False))
            return 1

    run_id = run_id_new()
    rd = run_dir(run_id)
    rd.mkdir(parents=True, exist_ok=True)

    # AE FIX (pipeline preflight): complete checks before an experiment clears outputs.
    if cmd_doctor(SimpleNamespace(profile="paper")) or cmd_cloud(SimpleNamespace(action="check", profile=scale)):
        if auto_provisioned:
            cmd_cloud(SimpleNamespace(action="down", count=None, no_runner=False))
        return 1
    ips = read_ip_list()
    if len(ips) < required:
        print(f"ERROR: {required} distinct hosts required; only {len(ips)} available.")
        if auto_provisioned:
            cmd_cloud(SimpleNamespace(action="down", count=None, no_runner=False))
        return 1
    active_ips = ips[:required]
    hardware_evidence = RUNS_DIR / "last-cloud-check.json"
    hardware_verified = False
    if hardware_evidence.is_file():
        evidence = json.loads(hardware_evidence.read_text())
        hardware_verified = scale == "full" and bool(evidence.get("hardware_execution_verified"))
    timeout_sec = int(os.environ.get("AE_TIMEOUT_SEC", "240"))
    fault_values = [int(value) for value in os.environ.get(
        "AE_FAULT_VALUES", "1 2 4 8 16 32"
    ).split()]
    load_clients = [int(value) for value in os.environ.get(
        "AE_LOAD_CLIENTS", "1 2 4 8 16 32"
    ).split()]
    manifest = {
        "run_id": run_id,
        "git_commit": git_commit(),
        "figs": figs,
        "scale": scale,
        "mode": mode,
        "cluster_ips": active_ips,
        "status": "running",
        "data_origin": "measured",
        "hardware_verified": hardware_verified,
        "topology": "one-replica-per-host" if scale == "full" else "seven-host-simulation-up-to-fifteen-replicas-per-host",
        "physical_host_count": len(active_ips),
        "logical_replica_capacity": len(active_ips) if scale == "full" else len(active_ips) * 15,
        "eligible_for_full_reproduction": scale == "full",
        "parameters": {"fault_values": fault_values,
            "batch_size": 400, "sgx_mode": "HW" if scale == "full" else "SIM",
            "replicas_per_host": 1 if scale == "full" else "1-15",
            "payload_fig3_fig4_bytes": 256, "payload_fig6_bytes": 1100,
            "redis_value_bytes": 1024,
            "redis_faults": int(os.environ.get("AE_REDIS_FAULTS", "8")),
            "redis_load_clients": load_clients,
            "redis_repeats": 3 if scale == "full" else 1,
            "warmup_views": 5,
            "wan_one_way_ms": 50,
            "orchestration_timeout_sec": timeout_sec,
            "timeout_policy": (
                "Inherited wall-clock guard; not a standard duration. A timeout is "
                "classified from preserved completion evidence and process logs."
            )},
        "started_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    }
    write_manifest(rd, manifest)
    # AE FIX (provenance): record dirty source state as well as commit identity.
    # Never copy the retired deployment key into run evidence. Older commits in
    # this repository contained TShard, so a raw `git diff HEAD` would embed its
    # deleted contents even though the file is no longer tracked.
    record_source_provenance(rd)
    hw = RUNS_DIR / "last-cloud-check.json"
    if hw.exists(): shutil.copy2(hw, rd / "hardware.json")
    shutil.copytree(REPO / "runs" / "reference", rd / "reference")
    log_event(rd, {"event": "run_start", "figs": figs, "scale": scale})

    # Write checksums of all scripts used
    checksums = checksum_scripts(figs)
    with open(rd / "checksums.txt", "w") as f:
        for path, digest in sorted(checksums.items()):
            f.write(f"{digest}  {path}\n")

    # Build environment for sub-scripts
    env = os.environ.copy()
    env["PYTHONUNBUFFERED"] = "1"
    env["AE_RUN_ID"] = run_id
    env["AE_RUN_DIR"] = str(rd)
    env["AE_HOST_LIMIT"] = str(required)
    # Keep credentials developer-owned while allowing scripts to use the same
    # configured key as run.py. The path is never written into the repository.
    try:
        key = configured_ssh_key()
    except (RuntimeError, OSError, json.JSONDecodeError):
        key = None
    if key is not None:
        env["RAFTEL_SSH_KEY"] = str(key)
    if scale == "simulation":
        env.update(SIMULATION_SCALE_ENV)

    failed_figs = []
    active_fig = None
    try:
        for fig in figs:
            active_fig = fig
            script = SCRIPTS[fig]
            print(f"\n{'='*60}")
            print(f"  Running {fig} (mode={mode})")
            print(f"{'='*60}")
            log_event(rd, {"event": "fig_start", "fig": fig})
            rc = subprocess.call(["bash", str(script)], env=env, cwd=str(REPO))
            # Archive before the next invocation clears experiment directories.
            archive_experiment_outputs(rd, fig)
            log_event(rd, {"event": "fig_end", "fig": fig, "exit": rc})
            if rc != 0:
                print(f"  {fig}: FAILED (exit {rc})")
                failed_figs.append(fig)
            else:
                print(f"  {fig}: OK")
    except KeyboardInterrupt:
        if active_fig:
            archive_experiment_outputs(rd, active_fig)
        failed_figs.extend(fig for fig in figs if fig not in failed_figs)
        update_manifest(rd, {
            "status": "failed",
            "failed_figs": failed_figs,
            "failure_reason": "reviewer_interrupted",
            "finished_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        })
        log_event(rd, {"event": "run_interrupted", "fig": active_fig})
        print(f"Run interrupted; partial evidence archived in {rd}", file=sys.stderr)
        if auto_provisioned:
            print("Releasing the auto-provisioned replica cluster...", file=sys.stderr)
            cmd_cloud(SimpleNamespace(action="down", count=None, no_runner=False))
        return 130

    status = "failed" if failed_figs else "complete"
    update_manifest(rd, {
        "status": status,
        "failed_figs": failed_figs,
        "finished_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    })
    log_event(rd, {"event": "run_end", "status": status, "failed_figs": failed_figs})

    print(f"\nRun ID: {run_id}")
    print(f"Run dir: {rd}")
    report_rc = cmd_report(SimpleNamespace(run_id=run_id))
    if report_rc:
        update_manifest(rd, {"status": "failed", "report_error": True})
        if auto_provisioned:
            cmd_cloud(SimpleNamespace(action="down", count=None, no_runner=False))
        return report_rc
    if failed_figs:
        print(f"FAILED figs: {failed_figs}")
        if auto_provisioned:
            cmd_cloud(SimpleNamespace(action="down", count=None, no_runner=False))
        return 1
    if auto_provisioned and os.environ.get("AE_KEEP_CLOUD", "0") != "1":
        print("Releasing the auto-provisioned replica cluster...")
        if cmd_cloud(SimpleNamespace(action="down", count=None, no_runner=False)) != 0:
            return 1
    print("All experiments complete.")
    print(f"Report: {rd / 'index.html'}")
    return 0


def cmd_report(args) -> int:
    """Generate figures and HTML report from a run directory."""
    run_id = getattr(args, "run_id", None) or latest_run_id()
    if not run_id:
        print("No run found. Run: ./ae run all", file=sys.stderr)
        return 1
    rd = run_dir(run_id)
    if not rd.exists():
        print(f"Run directory not found: {rd}", file=sys.stderr)
        return 1

    print(f"=== Generating report for run {run_id} ===")

    if REPORT_SCRIPT.exists():
        rc = subprocess.call([sys.executable, str(REPORT_SCRIPT), str(rd)])
        if rc != 0:
            print(f"Report generation failed (exit {rc})")
            return rc
    else:
        print(f"[WARN] {REPORT_SCRIPT} not yet implemented — run plots manually")

    report_html = rd / "index.html"
    if report_html.exists():
        print(f"\nReport: {report_html}")
    return 0


def cmd_status(args) -> int:
    """Show status of a run."""
    run_id = getattr(args, "run_id", None) or latest_run_id()
    if not run_id:
        print("No runs found.")
        return 0
    rd = run_dir(run_id)
    manifest_path = rd / "manifest.json"
    if not manifest_path.exists():
        print(f"Run {run_id}: manifest not found")
        return 1
    with open(manifest_path) as f:
        m = json.load(f)
    print(f"Run ID  : {m.get('run_id')}")
    print(f"Status  : {m.get('status')}")
    print(f"Mode    : {m.get('mode', m.get('scale'))}")
    print(f"Figs    : {m.get('figs')}")
    print(f"Started : {m.get('started_at')}")
    print(f"Finished: {m.get('finished_at', 'still running?')}")
    if m.get("failed_figs"):
        print(f"FAILED  : {m.get('failed_figs')}")
    return 0


def cmd_cloud(args) -> int:
    """Provision, initialize, validate, or release the cloud cluster."""
    action = args.action

    if action == "up":
        create_script = ALIYUN_DIR / "create_run_instances.py"
        wait_script = ALIYUN_DIR / "wait_instances_ready.py"
        if not create_script.is_file() or not wait_script.is_file():
            print("cloud lifecycle scripts are missing", file=sys.stderr)
            return 1
        existing_runner = ALIYUN_DIR / "runner.json"
        runner_backup = existing_runner.read_bytes() if existing_runner.is_file() else None
        command = [sys.executable, str(create_script)]
        count = getattr(args, "count", None)
        if count:
            command += ["--count", str(count)]
        if getattr(args, "profile", "paper") == "simulation":
            command += ["--profile", "simulation"]
        if getattr(args, "no_runner", False):
            command.append("--no-runner")
        if subprocess.call(command, cwd=str(REPO)) != 0:
            return 1
        try:
            wait_rc = subprocess.call(
                [sys.executable, str(wait_script)], cwd=str(REPO)
            )
        finally:
            # Replica-only discovery writes an empty runner record. Preserve
            # the prepared coordinator identity even when readiness fails.
            if runner_backup is not None:
                existing_runner.write_bytes(runner_backup)
        return 0 if wait_rc == 0 else 1

    if action == "init":
        for script in (DEPLOYMENT_DIR / "cloud_deploy.sh", DEPLOYMENT_DIR / "cloud_config.sh"):
            if not script.is_file():
                print(f"missing deployment script: {script}", file=sys.stderr)
                return 1
            if subprocess.call(["bash", str(script)], cwd=str(REPO)) != 0:
                return 1
        return 0

    if action == "down":
        script = ALIYUN_DIR / "delete_instances.py"
        if not script.is_file():
            print(f"missing release script: {script}", file=sys.stderr)
            return 1
        return subprocess.call([sys.executable, str(script)], cwd=str(REPO))

    if action == "check":
        if running_on_cloud_runner():
            os.environ["RAFTEL_USE_PRIVATE_SSH"] = "1"
        ips = read_ip_list()
        if not ips:
            print("aliyun/priv_ip.txt is empty — coordinator inventory is not prepared")
            return 1
        inventory_path = ALIYUN_DIR / "hosts.json"
        if inventory_path.is_file():
            inventory = json.loads(inventory_path.read_text())
            ips = list(dict.fromkeys(
                h.get("private_ip") for h in inventory if h.get("private_ip")
            ))
        sys.path.insert(0, str(REPO / "scripts"))
        from cloud_check import check_cluster
        return check_cluster(
            ips, configured_ssh_key(), RUNS_DIR / "last-cloud-check.json",
            profile=getattr(args, "profile", "paper"),
        )

    print(f"Unknown cloud action: {action}", file=sys.stderr)
    return 1


# ---------------------------------------------------------------------------
# CLI wiring
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="ae",
        description="Raftel Artifact Evaluation CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # doctor
    p_doctor = sub.add_parser("doctor", help="Check environment")
    p_doctor.set_defaults(profile="paper")
    p_doctor.set_defaults(func=cmd_doctor)

    # run
    p_run = sub.add_parser("run", help="Run experiment(s)")
    p_run.add_argument("fig", choices=("fig3", "fig4", "fig6", "all"))
    p_run.add_argument("--mode", choices=("sim", "full"), default=None,
                       help="sim=7 multiplexed hosts with SGX SIM; full=one SGX HW VM per replica")
    p_run.add_argument("--on-runner", action="store_true", help=argparse.SUPPRESS)
    p_run.set_defaults(func=cmd_run)

    # report
    p_report = sub.add_parser("report", help="Generate figures and HTML report")
    p_report.add_argument("run_id", nargs="?", default=None)
    p_report.set_defaults(func=cmd_report)

    # status
    p_status = sub.add_parser("status", help="Show run status")
    p_status.add_argument("run_id", nargs="?", default=None)
    p_status.set_defaults(func=cmd_status)

    # cloud
    p_cloud = sub.add_parser("cloud", help="Validate the prepared replica cluster")
    p_cloud.add_argument("action", choices=("check",))
    p_cloud.set_defaults(count=None, no_runner=False, profile="paper")
    p_cloud.set_defaults(func=cmd_cloud)

    args = parser.parse_args()
    # AE FIX: shared binaries/config/current paths require an exclusive run lock.
    if args.command == "run":
        with open(REPO / ".ae.lock", "w") as lock:
            try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                print("ERROR: another AE run is active", file=sys.stderr); return 1
            return args.func(args)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
