#!/usr/bin/env python3
"""Raftel Artifact Evaluation CLI.

Usage:
  ./ae doctor
  ./ae run <fig3|fig4|fig6|all> [--mode sim|full]
  ./ae report [RUN_ID]
  ./ae status [RUN_ID]
  ./ae cloud check
"""

from __future__ import annotations

import argparse
import datetime
import hashlib
import fcntl
from types import SimpleNamespace
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent
RUNS_DIR = REPO / "runs"
ALIYUN_DIR = REPO / "aliyun"
DEPLOYMENT_DIR = REPO / "deployment"
SCRIPTS = {
    "fig3": REPO / "experiments_reproduction" / "experiment1" / "script" / "run_wan.sh",
    "fig4": REPO / "experiments_reproduction" / "experiment2" / "script" / "run_lan.sh",
    "fig6": REPO / "experiments_reproduction" / "experiment3" / "script" / "run_redis_wan.sh",
}
REPORT_SCRIPT = REPO / "scripts" / "gen_report.py"

# Simulation is the original cost-saving topology: seven physical hosts carry
# up to fifteen logical replicas each (105 total), which covers n=97 at f=32.
# It runs the complete sweep in SGX SIM mode and cannot support hardware claims.
SIMULATION_SCALE_ENV = {
    "AE_SCALE": "simulation",
    "AE_SGX_MODE": "SIM",
    "AE_FAULT_VALUES": "1 2 4 8 16 32",
    "AE_LOAD_CLIENTS": "1 2 4 8 16 32",
    "AE_REDIS_FAULTS": "8",
    "AE_REPEATS": "1",
    "AE_ALLOW_MULTIPLEXING": "1",
    # Match the original runner's orchestration window. Simulation validates an
    # explicit protocol quorum rather than waiting for every multiplexed
    # process to exit.
    "AE_TIMEOUT_SEC": "240",
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def run_id_new() -> str:
    override = os.environ.get("AE_RUN_ID_OVERRIDE")
    if override:
        if not all(c.isalnum() or c in ".-_" for c in override):
            raise ValueError("Invalid AE_RUN_ID_OVERRIDE")
        return override
    ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    return ts


def run_dir(run_id: str) -> Path:
    return RUNS_DIR / run_id


def latest_run_id() -> str | None:
    if not RUNS_DIR.exists():
        return None
    runs = sorted(
        (d.name for d in RUNS_DIR.iterdir() if d.is_dir() and (d / "manifest.json").is_file()),
        reverse=True,
    )
    return runs[0] if runs else None


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def write_manifest(run_dir: Path, data: dict) -> None:
    run_dir.mkdir(parents=True, exist_ok=True)
    with open(run_dir / "manifest.json", "w") as f:
        json.dump(data, f, indent=2)


def update_manifest(run_dir: Path, updates: dict) -> None:
    manifest_path = run_dir / "manifest.json"
    manifest = {}
    if manifest_path.exists():
        with open(manifest_path) as f:
            manifest = json.load(f)
    manifest.update(updates)
    with open(manifest_path, "w") as f:
        json.dump(manifest, f, indent=2)


def archive_experiment_outputs(rd: Path, fig: str) -> None:
    """Copy the current experiment tree into the run, including partial runs."""
    exp = {"fig3": "experiment1", "fig4": "experiment2", "fig6": "experiment3"}[fig]
    source = REPO / "experiments_reproduction" / exp
    target = rd / "raw" / exp
    target.mkdir(parents=True, exist_ok=True)
    for name in ("stats.txt", "log", "results"):
        src = source / name
        if src.is_dir():
            shutil.copytree(src, target / name, dirs_exist_ok=True)
        elif src.exists():
            shutil.copy2(src, target / name)


def log_event(run_dir: Path, event: dict) -> None:
    run_dir.mkdir(parents=True, exist_ok=True)
    event["timestamp"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
    with open(run_dir / "events.jsonl", "a") as f:
        f.write(json.dumps(event) + "\n")


def git_commit() -> str:
    try:
        return subprocess.check_output(
            ["git", "rev-parse", "HEAD"], cwd=str(REPO), text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except Exception:
        try:
            return json.loads((REPO / ".ae-source.json").read_text())["git_commit"]
        except (OSError, KeyError, json.JSONDecodeError):
            return "unknown"


def record_source_provenance(rd: Path) -> None:
    """Record the exact deployed snapshot without requiring a .git checkout."""
    deployed_manifest = REPO / ".ae-source.json"
    deployed_diff = REPO / ".ae-source.diff"
    if deployed_manifest.is_file():
        shutil.copy2(deployed_manifest, rd / "source-manifest.json")
    if (REPO / ".git").exists():
        source_diff = subprocess.check_output(
            ["git", "diff", "HEAD", "--binary", "--", ".", ":(exclude)TShard"],
            cwd=REPO,
        )
        (rd / "source.diff").write_bytes(source_diff)
    elif deployed_diff.is_file():
        shutil.copy2(deployed_diff, rd / "source.diff")
    else:
        (rd / "source.diff").write_text(
            "Source diff unavailable; see checksums.txt for executed inputs.\n"
        )


def checksum_scripts(figs: list[str]) -> dict:
    result = {}
    for fig in figs:
        script = SCRIPTS.get(fig)
        if script and script.exists():
            result[str(script.relative_to(REPO))] = sha256_file(script)
    run_py = REPO / "run.py"
    if run_py.exists():
        result["run.py"] = sha256_file(run_py)
    return result


def read_ip_list() -> list[str]:
    ip_file = ALIYUN_DIR / "priv_ip.txt"
    if not ip_file.exists():
        return []
    with open(ip_file) as f:
        return list(dict.fromkeys(line.strip() for line in f if line.strip()))


def clear_stale_replica_ledger() -> None:
    """Remove lifecycle records left by a released replica-only cluster.

    The developer-owned runner is tracked separately in runner.json. When its
    replica inventory is empty, a stale instances.txt must not prevent the
    reviewer entry point from provisioning a fresh disposable replica cluster.
    """
    if read_ip_list():
        return
    for name in ("instances.txt", "cluster_plan.json", "public_ip.txt"):
        path = ALIYUN_DIR / name
        if path.is_file():
            path.write_text("")


def configured_ssh_key() -> Path:
    sys.path.insert(0, str(ALIYUN_DIR))
    try:
        from cloud_common import load_config, ssh_key
        return ssh_key(load_config())
    except (RuntimeError, OSError, json.JSONDecodeError):
        return REPO / "TShard"


def cloud_runner() -> dict:
    path = ALIYUN_DIR / "runner.json"
    if not path.is_file():
        return {}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        return {}


def running_on_cloud_runner() -> bool:
    """Return true when this process is already on the inventoried runner."""
    runner = cloud_runner()
    expected = {runner.get("private_ip"), runner.get("public_ip")} - {None, ""}
    if not expected:
        return False
    try:
        local_addresses = set(subprocess.check_output(
            ["hostname", "-I"], text=True, timeout=5
        ).split())
    except (OSError, subprocess.SubprocessError):
        return False
    return bool(expected & local_addresses)


def run_via_cloud_runner(args) -> int:
    """Execute builds and clients inside the VPC, then fetch the immutable run."""
    runner = cloud_runner()
    host = runner.get("public_ip")
    if not host:
        print("ERROR: cloud runner inventory has no public IP", file=sys.stderr)
        return 1
    run_id = run_id_new()
    key = configured_ssh_key()
    common = [
        "-i", str(key), "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
        "-o", "StrictHostKeyChecking=accept-new",
    ]
    mode = resolve_mode(args)
    remote = (
        f"cd /root/Raftel && RAFTEL_USE_PRIVATE_SSH=1 AE_RUN_ID_OVERRIDE={run_id} "
        f"./ae run {args.fig} --mode {mode} --on-runner"
    )
    print(
        f"Running on cloud runner {host}; experiment traffic remains inside the VPC."
    )
    rc = subprocess.call(["ssh", *common, f"root@{host}", remote])
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    fetch = subprocess.call([
        "scp", "-r", *common, f"root@{host}:/root/Raftel/runs/{run_id}",
        str(RUNS_DIR),
    ])
    if fetch != 0:
        print(f"ERROR: could not fetch run {run_id} from cloud runner", file=sys.stderr)
        return fetch
    local_run = run_dir(run_id)
    if rc != 0:
        print(f"ERROR: cloud run {run_id} failed with exit {rc}.", file=sys.stderr)
        print(f"Diagnostic evidence: {local_run}")
        return rc
    report = local_run / "index.html"
    if not report.is_file():
        print(f"ERROR: cloud run completed without a report: {report}", file=sys.stderr)
        return 1
    print(f"Fetched report: {report}")
    return 0


def resolve_mode(args) -> str:
    """Return the selected public execution mode."""
    return getattr(args, "mode", None) or "full"


def prepare_mode_environment(mode: str) -> None:
    """Reset mode-controlled variables and apply the selected public profile."""
    controlled = (
        "AE_SGX_MODE", "AE_SCALE",
        "AE_FAULT_VALUES", "AE_LOAD_CLIENTS", "AE_REDIS_FAULTS", "AE_REPEATS",
        "AE_ALLOW_MULTIPLEXING", "AE_TIMEOUT_SEC",
    )
    for name in controlled:
        os.environ.pop(name, None)
    if mode == "sim":
        os.environ.update(SIMULATION_SCALE_ENV)
    elif mode == "full":
        os.environ["AE_SGX_MODE"] = "HW"
    else:
        raise ValueError(f"unsupported mode: {mode}")


def required_host_count(figs: list[str], mode: str) -> int:
    """Return physical replica hosts required by one reviewer invocation."""
    if mode == "sim":
        return 7
    if mode != "full":
        raise ValueError(f"unsupported mode: {mode}")
    return 97 if any(fig in figs for fig in ("fig3", "fig4")) else 25


